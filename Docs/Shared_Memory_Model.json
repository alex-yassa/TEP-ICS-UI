        },
        {
          "name": "grid_q",
          "type": "float[3]",
          "unit": "kVAR",
          "hardware_mapping": "GridQ1, GridQ2, GridQ3",
          "description": "PS300 AC output reactive power per phase"
        },
        {
          "name": "grid_p_total",
          "type": "float",
          "unit": "kW",
          "hardware_mapping": "GridP",
          "description": "PS300 AC output total active power"
        },
        {
          "name": "grid_q_total",
          "type": "float",
          "unit": "kVAR",
          "hardware_mapping": "GridQ",
          "description": "PS300 AC output total reactive power"
        },
        {
          "name": "grid_freq",
          "type": "float",
          "unit": "Hz",
          "hardware_mapping": "GridFreq",
          "description": "PS300 AC output frequency"
        },
        {
          "name": "inv_temp",
          "type": "float",
          "unit": "°C",
          "hardware_mapping": "InvTemp",
          "description": "PS300 internal inverter temperature"
