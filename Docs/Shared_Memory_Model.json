        {
          "name": "inp_p",
          "type": "float[2]",
          "unit": "kW",
          "hardware_mapping": "InpP1, InpP2",
          "description": "PV DC input power per tracker"
        },
        {
          "name": "grid_u",
          "type": "float[3]",
          "unit": "V",
          "hardware_mapping": "GridU1, GridU2, GridU3",
          "description": "PS300 AC output phase voltages"
        },
        {
          "name": "grid_i",
          "type": "float[3]",
          "unit": "A",
          "hardware_mapping": "GridI1, GridI2, GridI3",
          "description": "PS300 AC output phase currents"
        },
        {
          "name": "grid_p",
          "type": "float[3]",
          "unit": "kW",
          "hardware_mapping": "GridP1, GridP2, GridP3",
