{
  "model_name": "AC-Coupled Microgrid Central EMS Shared Memory Model",
  "version": "1.2.0",
  "base_address": "0x30040000",
  "semaphore_id": 1,
  "hsem_name": "HSEM_ID_SHARED_MEM",
  "struct_name": "SharedBuffer_t",
  "constants": {
    "MAX_BATTERY_CLUSTERS": 2,
    "MAX_PV_CLUSTERS": 2
  },
  "types": {
    "BatteryStorageCluster_t": {
      "description": "Unified battery bank and BESS inverter cluster telemetry structure aligned with BSI1000 registers",
      "size_bytes": 80,
      "fields": [
        {
          "name": "grid_p",
          "type": "float[3]",
          "unit": "kW",
          "hardware_mapping": "GridP1, GridP2, GridP3",
          "description": "BSI AC active power per phase. Positive=discharge, Negative=charge."
        },
        {
          "name": "grid_q",
          "type": "float[3]",
          "unit": "kVAR",
          "hardware_mapping": "GridQ1, GridQ2, GridQ3",
          "description": "BSI AC reactive power per phase injected/absorbed"
        },
        {
          "name": "grid_i",
          "type": "float[3]",
          "unit": "A",
          "hardware_mapping": "GridI1, GridI2, GridI3",
          "description": "BSI AC current per phase"
        },
        {
          "name": "batt_u",
          "type": "float",
          "unit": "V",
          "hardware_mapping": "BattU",
          "description": "Battery pack DC voltage"
        },
        {
          "name": "batt_i",
          "type": "float",
          "unit": "A",
          "hardware_mapping": "BattI",
          "description": "Battery pack DC current. Positive=discharge, Negative=charge."
        },
        {
          "name": "batt_soc",
          "type": "float",
          "unit": "%",
          "hardware_mapping": "SoCBatt",
          "description": "Battery pack State of Charge"
        },
        {
          "name": "batt_soh",
          "type": "float",
          "unit": "%",
          "description": "Battery pack State of Health from BMS CANbus"
        },
        {
          "name": "batt_temp",
          "type": "float",
          "unit": "°C",
          "hardware_mapping": "BattTemp",
          "description": "Battery pack average cell temperature"
        },
        {
          "name": "batt_alarm",
          "type": "uint32_t",
          "unit": "bits",
          "description": "Battery pack BMS alarms bitfield"
        },
        {
          "name": "batt_fault",
          "type": "uint32_t",
          "unit": "bits",
          "description": "Battery pack BMS faults bitfield"
        },
        {
          "name": "dci_temp",
          "type": "float",
          "unit": "°C",
          "hardware_mapping": "DCITemp",
          "description": "BSI DCI board heatsink temperature"
        },
        {
          "name": "acr_temp",
          "type": "float",
          "unit": "°C",
          "hardware_mapping": "AcRTemp",
          "description": "BSI ACR board heatsink temperature"
        },
        {
          "name": "bsi_status_flags",
          "type": "uint32_t",
          "unit": "bits",
          "hardware_mapping": "Status",
          "description": "BSI1000 internal status register"
        },
        {
          "name": "bsi_st",
          "type": "uint8_t",
          "unit": "enum",
          "description": "BSI inverter operational state",
          "enum_values": {
            "0": "BSI_STATE_OFFLINE",
            "1": "BSI_STATE_GRID_FOLLOW_IDLE",
            "2": "BSI_STATE_GRID_FOLLOW_CHARGE",
            "3": "BSI_STATE_GRID_FOLLOW_DISCHARGE",
            "4": "BSI_STATE_GRID_FORMING",
            "5": "BSI_STATE_STATCOM",
            "6": "BSI_STATE_FAULT"
          }
        }
      ]
    },
    "PvGenerationCluster_t": {
      "description": "Unified PV array and grid-tied solar inverter telemetry structure aligned with PS300-PV registers",
