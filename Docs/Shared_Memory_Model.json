          "unit": "bits",
          "hardware_mapping": "Flags1",
          "description": "PS300 status flags register 1"
        },
        {
          "name": "flags2",
          "type": "uint32_t",
          "unit": "bits",
          "hardware_mapping": "Flags2",
          "description": "PS300 status flags register 2"
